# Environment variables for the example application.
# Override them locally in .env.local (not committed).

APP_ENV=dev
# Demo value only. Generate your own secret for a real application.
APP_SECRET=cqrs-example-app-not-a-real-secret
# SQLite file of the tasks, their activity and the outbox.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
