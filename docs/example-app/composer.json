{
    "name": "somework/cqrs-example",
    "type": "project",
    "description": "Example Symfony application showcasing somework/cqrs-bundle with a task-management domain.",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "somework/cqrs-bundle": "*@dev",
        "symfony/console": "^7.2 || ^8.0",
        "symfony/dotenv": "^7.2 || ^8.0",
        "symfony/framework-bundle": "^7.2 || ^8.0",
        "symfony/messenger": "^7.2 || ^8.0",
        "symfony/yaml": "^7.2 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
